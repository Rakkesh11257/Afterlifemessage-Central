##############################
# Backend environment example
# (Do NOT commit real values)
##############################

# DynamoDB + S3 resource names (non-secret, but environment-specific)
USERS_TABLE=afterlifemessage-backend-users-dev
DYNAMODB_TABLE=afterlifemessage-backend-messages-dev
S3_BUCKET=afterlifemessage-dev

# Email (ZeptoMail)
ZEPTO_PASSWORD=your-zepto-password-here
ZEPTO_FROM_EMAIL=noreply@your-domain.com

# WhatsApp
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Encryption
ENCRYPTION_KEY=your-32-byte-hex-key

# Twilio (if used)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+1XXXXXXXXXX

# Razorpay (if used in backend)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret


