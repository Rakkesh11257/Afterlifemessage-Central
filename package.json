{
  "name": "afterlifemessage-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^5.0.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "autoprefixer": "^10.4.0",
    "aws-amplify": "^5.0.0",
    "axios": "^1.3.0",
    "crypto-js": "^4.1.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.263.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.43.0",
    "react-hot-toast": "^2.4.0",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "recharts": "^3.1.0",
    "tailwindcss": "^3.2.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:dev": "set REACT_APP_ENV=development && react-scripts build",
    "build:prod": "set REACT_APP_ENV=production && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy:dev": "npm run build:dev && aws s3 sync build/ s3://afterlifemessage-frontend-dev --delete",
    "deploy:prod": "npm run build:prod && aws s3 sync build/ s3://afterlifemessage-frontend-prod --delete",
    "deploy:backend:dev": "cd backend && serverless deploy --stage dev",
    "deploy:backend:prod": "cd backend && serverless deploy --stage prod",
    "deploy:full:dev": "npm run deploy:backend:dev && npm run deploy:dev",
    "deploy:full:prod": "npm run deploy:backend:prod && npm run deploy:prod"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
